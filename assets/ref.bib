@unpublished{laurence2026executive,
  title={What Executive Function Specialists Think About Executive Function Intervention and Training},
  author={Laurence, Paulo and Bailey, Drew},
  year={2026},
  publisher={OSF},
link={https://doi.org/10.31234/osf.io/pa4qg_v1},
abstract={Executive Function (EF) interventions are widely studied, yet evidence for durable and transferable benefits remains mixed. This exploratory study examined contemporary views among EF specialists regarding which interventions hold the greatest promise, which outcomes are most valid, and why far transfer is often weak or absent. Thirty-six EF specialists completed a brief online questionnaire combining ranking items and open-ended responses. Curriculum-based interventions were the most highly endorsed approach, followed by self-regulation strategy training and non-computerized EF training, although agreement on intervention priorities was low. Laboratory-based cognitive tasks were the most strongly endorsed outcome measure, but real-world behavioral observations were also strongly supported, indicating tension between experimental precision and ecological relevance. Researchers’ preferred criteria for evaluating success were associated with their research backgrounds and intervention preferences. Support for skill-focused approaches, particularly computerized EF training, was more closely aligned with preference for laboratory-based outcomes, whereas support for context-embedded approaches, such as curriculum-based programs, was more closely aligned with real-world behavioral measures. Qualitative analyses suggested that limited far transfer is commonly attributed to narrow and decontextualized training, weak alignment between training and outcomes, limited ecological validity, the contextual and cultural nature of EF, motivational and individual moderators, and methodological constraints. Overall, the findings suggest that disagreement in the field is not only about which interventions work, but also about what kind of evidence is taken to demonstrate that they work, pointing toward more context-embedded, developmentally sensitive, and mechanistically grounded intervention frameworks.}
}

@unpublished{tafla2026psychometric,
  title={Psychometric properties of the Brazilian version of the Camouflaging Autistic Traits Questionnaire},
  author={Tafla, Tally and Laurence, Paulo and Godoy, Priscilla and Bruckner, Juliana and Hull, Laura and Mandy, William and Shephard, Elizabeth},
  year={2026},
  publisher={OSF},
link={https://doi.org/10.31234/osf.io/3bpc5_v2},
abstract={To adapt to social expectations and gain peer acceptance, autistic individuals may engage in compensatory behaviors, known as camouflaging, which has been associated with mental health outcomes including depression and anxiety. Instruments that accurately measure camouflaging in autistic individuals are therefore important. The Camouflaging Autistic Traits Questionnaire (CAT-Q) is widely used in literature and shows good psychometric properties. However, most non-English-speaking countries such as Brazil, lack validated instruments to assess camouflaging behaviours. The present study reports the adaptation of the CAT-Q for Brazil and examines the psychometric properties of its Brazilian version. The translation and cultural adaptation had independent translations and evaluation by expert judges, including autistic adults. A total of 923 autistic and 470 non-autistic adults from across Brazil completed the CAT-Q-BR and the Autism Quotient–Short Version (AQ-10). Confirmatory factor analyses tested the original three-factor structure of the CAT-Q-BR; Convergent validity was examined through associations with autistic traits on the AQ-10 and self-reported anxiety and depression diagnoses and known-groups validity (gender differences) were also analyzed. Results supported the original structure, with acceptable model fit (CFI = 0.964, TLI = 0.96, RMSEA = 0.076, SRMR = 0.066) and internal consistency for total score was good (α = 0.88). No significant association was found between CAT-Q-BR and the AQ-10. However, higher camouflaging scores were significantly associated with self-reported anxiety and depression. Gender-diverse participants reported higher camouflaging compared to cisgender men and women. Overall, findings provide initial evidence supporting the CAT-Q-BR as a reliable measure of camouflaging behaviors in Brazilian adults.}
}

@unpublished{laurence2024neurodiversity,
  title={Neurodiversity-Driven Cognitive Development Framework: Integrating Strength-Based Approaches, Neurodiversity, and Contextual Understanding of Executive Functions},
  author={Laurence, Paulo and Placido, Diego and Tafla, Tally},
  year={2024},
  publisher={OSF},
link={https://doi.org/10.31234/osf.io/6ys54},
abstract={This manuscript introduces an integrated framework connecting the strength-based approach, the neurodiversity approach, and the contextual understanding of executive functions. By challenging traditional deficit-oriented models, this framework advocates for recognizing the adaptive and context-dependent nature of cognitive abilities. We explore how these approaches collectively validate the diverse experiences of neurodivergent individuals and those from different cultural backgrounds, highlighting their unique strengths. Through an interdisciplinary lens, we emphasize the role of environmental and societal factors in shaping cognitive performance, advocating for more holistic and equitable assessments and promoting perspectives that acknowledge and value a range of skills when attempting to provide developmental support plans. This paradigm shift in psychology moves towards a diversity-oriented perspective, calling for systemic changes in how we assess, support, and value diverse cognitive profiles. We suggest that embracing this comprehensive approach can lead to more effective educational and clinical practices, fostering environments where all individuals can thrive.}
}




